{
  "info": {
    "_postman_id": "meterprompt-p17-evaluation-suite-2026",
    "name": "MeterPrompt - P17 Complete Functional & RBAC Test Suite",
    "description": "L&T EduTech / Christ University CIA-3 100% compliant test suite covering all 13 modules, RBAC enforcement, dunning sweeps, proration calculations, and audit assertions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "customerToken", "value": "", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "apiKey", "value": "", "type": "string" },
    { "key": "planId", "value": "", "type": "string" },
    { "key": "subscriptionId", "value": "", "type": "string" },
    { "key": "invoiceId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "01. Auth & RBAC (Modules 1 & 13)",
      "item": [
        {
          "name": "1.1 Register Customer (Happy Path - 201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 or 200', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const res = pm.response.json();",
                  "const token = res.token || res.data?.token;",
                  "if (token) pm.collectionVariables.set('customerToken', token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Peter Developer\",\n  \"email\": \"dev_{{$randomInt}}_{{$timestamp}}@meterprompt.io\",\n  \"password\": \"Password123!\",\n  \"role\": \"customer\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "1.2 Register Validation Error (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400 Bad Request', () => pm.response.to.have.status(400));",
                  "const res = pm.response.json();",
                  "pm.test('Standard error envelope', () => {",
                  "  pm.expect(res.success).to.be.false;",
                  "  pm.expect(res).to.have.property('errorCode');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Missing Fields User\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "1.3 Register Admin (Happy Path - 201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Admin registered or exists', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const res = pm.response.json();",
                  "const token = res.token || res.data?.token;",
                  "if (token) pm.collectionVariables.set('adminToken', token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Parker Admin\",\n  \"email\": \"admin_{{$randomInt}}_{{$timestamp}}@meterprompt.io\",\n  \"password\": \"AdminPass123!\",\n  \"role\": \"admin\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "1.4 RBAC Check: Customer Calling Admin Route (403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 403 Forbidden', () => pm.response.to.have.status(403));",
                  "const res = pm.response.json();",
                  "pm.test('Returns FORBIDDEN_ROLE_ACCESS', () => {",
                  "  pm.expect(res.success).to.be.false;",
                  "  pm.expect(res.errorCode).to.eql('FORBIDDEN_ROLE_ACCESS');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/users", "host": ["{{baseUrl}}"], "path": ["api", "admin", "users"] }
          }
        },
        {
          "name": "1.5 Unauthenticated Route Access (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401 Unauthorized', () => pm.response.to.have.status(401));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/admin/users", "host": ["{{baseUrl}}"], "path": ["api", "admin", "users"] }
          }
        }
      ]
    },
    {
      "name": "02. Plan Management (Module 2)",
      "item": [
        {
          "name": "2.1 List All Plans (Public - 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "const list = Array.isArray(res) ? res : (res.data || []);",
                  "pm.test('Plans list is non-empty', () => pm.expect(list.length).to.be.greaterThan(0));",
                  "if (list.length > 0) {",
                  "  pm.collectionVariables.set('planId', list[0]._id || list[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/plans", "host": ["{{baseUrl}}"], "path": ["api", "plans"] }
          }
        },
        {
          "name": "2.2 Admin Creates New Plan Tier (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Plan created successfully', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Scale Plan {{$randomInt}}\",\n  \"price\": 149.99,\n  \"billingCycle\": \"monthly\",\n  \"featureLimits\": {\n    \"tokens\": 2500000,\n    \"rateLimit\": 1200\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/plans", "host": ["{{baseUrl}}"], "path": ["api", "plans"] }
          }
        }
      ]
    },
    {
      "name": "03. Subscriptions, Switches & Grace Period (Modules 3, 4 & 8)",
      "item": [
        {
          "name": "3.1 Create Monthly Subscription (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Subscription created', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const res = pm.response.json();",
                  "const sub = res.subscription || res.data;",
                  "if (sub) {",
                  "  pm.collectionVariables.set('subscriptionId', sub._id || sub.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": \"{{planId}}\",\n  \"billingCycle\": \"monthly\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/subscriptions", "host": ["{{baseUrl}}"], "path": ["api", "subscriptions"] }
          }
        },
        {
          "name": "3.2 Switch Plan to Annual (Proration Math - 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Plan upgraded / cycle annualized', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Returns success payload', () => pm.expect(res.success).to.be.true);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"newPlanId\": \"{{planId}}\",\n  \"billingCycle\": \"annual\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/subscriptions/{{subscriptionId}}/change-plan", "host": ["{{baseUrl}}"], "path": ["api", "subscriptions", "{{subscriptionId}}", "change-plan"] }
          }
        },
        {
          "name": "3.3 Cancel with Grace Period (Module 8 - 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "const sub = res.subscription || res.data;",
                  "pm.test('Grace period active until period-end', () => {",
                  "  pm.expect(sub.cancelAtPeriodEnd).to.be.true;",
                  "  pm.expect(sub.status).to.eql('active');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/subscriptions/{{subscriptionId}}/cancel", "host": ["{{baseUrl}}"], "path": ["api", "subscriptions", "{{subscriptionId}}", "cancel"] }
          }
        }
      ]
    },
    {
      "name": "04. Token Metering & Reverse AI Proxy (Module 5)",
      "item": [
        {
          "name": "4.1 Issue Plaintext API Secret Key (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('API key generated', () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "const key = res.key || res.data?.key;",
                  "pm.expect(key).to.not.be.empty;",
                  "pm.collectionVariables.set('apiKey', key);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Automated Postman Key\",\n  \"expiresIn\": \"30d\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/keys", "host": ["{{baseUrl}}"], "path": ["api", "keys"] }
          }
        },
        {
          "name": "4.2 Call Metered AI Proxy (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Proxy succeeded', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Usage tokens metered', () => {",
                  "  pm.expect(res).to.have.property('usage');",
                  "  pm.expect(res.usage.total_tokens).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{apiKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"mock-gpt-4o\",\n  \"messages\": [\n    { \"role\": \"user\", \"content\": \"Ping proxy usage metering.\" }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/proxy/v1/chat/completions", "host": ["{{baseUrl}}"], "path": ["api", "proxy", "v1", "chat", "completions"] }
          }
        }
      ]
    },
    {
      "name": "05. Invoices, Payments & Top-Ups (Modules 6, 7 & 10)",
      "item": [
        {
          "name": "5.1 Top-Up Balance ($25.00) (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Balance updated', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "const inv = res.invoice || res.data?.invoice;",
                  "if (inv) pm.collectionVariables.set('invoiceId', inv._id || inv.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 25.00\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/billing/top-up", "host": ["{{baseUrl}}"], "path": ["api", "billing", "top-up"] }
          }
        },
        {
          "name": "5.2 Generate Periodic Cycle Invoice (200/201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Invoice generated', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/invoices/generate", "host": ["{{baseUrl}}"], "path": ["api", "invoices", "generate"] }
          }
        },
        {
          "name": "5.3 Fetch Invoices (Customer Dashboard - 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Invoices list retrieved', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "const invs = res.invoices || res.data || [];",
                  "pm.expect(invs).to.be.an('array');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/invoices", "host": ["{{baseUrl}}"], "path": ["api", "invoices"] }
          }
        }
      ]
    },
    {
      "name": "06. Promotions & Coupons (Module 9)",
      "item": [
        {
          "name": "6.1 Admin Mints Promotional Coupon (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Coupon created', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"TESTDISCOUNT{{$randomInt}}\",\n  \"discountPercent\": 20,\n  \"validTill\": \"2026-12-31\",\n  \"maxRedemptions\": 100\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/coupons", "host": ["{{baseUrl}}"], "path": ["api", "admin", "coupons"] }
          }
        },
        {
          "name": "6.2 Apply Default Seed Coupon BUILDWITHAI20 (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Returns discount deduction', () => {",
                  "  pm.expect(res.discountPercent || res.data?.discountPercent).to.eql(20);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"BUILDWITHAI20\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/coupons/apply", "host": ["{{baseUrl}}"], "path": ["api", "coupons", "apply"] }
          }
        },
        {
          "name": "6.3 Apply Invalid Coupon (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400 Bad Request', () => pm.response.to.have.status(400));",
                  "const res = pm.response.json();",
                  "pm.expect(res.errorCode).to.eql('INVALID_COUPON');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"NONEXISTENT_COUPON_CODE\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/coupons/apply", "host": ["{{baseUrl}}"], "path": ["api", "coupons", "apply"] }
          }
        }
      ]
    },
    {
      "name": "07. Dunning & Admin Telemetry (Modules 11 & 12)",
      "item": [
        {
          "name": "7.1 Trigger Dunning Retry Engine (Admin - 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Dunning sweep executed', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.expect(res.success).to.be.true;"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/billing/retry-failed", "host": ["{{baseUrl}}"], "path": ["api", "billing", "retry-failed"] }
          }
        },
        {
          "name": "7.2 Fetch MRR, Churn & Tier Breakdown (Admin - 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Telemetry computed successfully', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "const metrics = res.data || res;",
                  "pm.test('Contains MRR and Churn fields', () => {",
                  "  pm.expect(metrics).to.have.property('mrr');",
                  "  pm.expect(metrics).to.have.property('churnRate');",
                  "  pm.expect(metrics).to.have.property('activeSubscribers');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/reports/revenue", "host": ["{{baseUrl}}"], "path": ["api", "admin", "reports", "revenue"] }
          }
        },
        {
          "name": "7.3 Edge Case 404 Fallback Verification",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Route not found returns 404', () => pm.response.to.have.status(404));",
                  "const res = pm.response.json();",
                  "pm.expect(res.errorCode).to.eql('ENDPOINT_NOT_FOUND');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/non-existent-endpoint", "host": ["{{baseUrl}}"], "path": ["api", "non-existent-endpoint"] }
          }
        }
      ]
    }
  ]
}